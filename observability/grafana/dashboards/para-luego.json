{
  "uid": "para-luego",
  "title": "Para Luego",
  "tags": [
    "para-luego"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "refresh": "10s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "panels": [
    {
      "id": 7,
      "type": "alertlist",
      "title": "Alerts (SaveItemFailing, HighServerErrors)",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 6
      },
      "options": {
        "viewMode": "list",
        "groupMode": "default",
        "maxItems": 10,
        "sortOrder": 1,
        "dashboardAlerts": false,
        "alertName": "",
        "folder": {
          "title": "Para Luego"
        },
        "stateFilter": {
          "firing": true,
          "pending": true,
          "noData": true,
          "normal": true,
          "error": true
        },
        "showInstances": true
      }
    },
    {
      "id": 1,
      "type": "timeseries",
      "title": "Requests per second by route and status",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 24,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (job, method, route, status) (rate(http_requests_total[1m]))",
          "legendFormat": "{{job}} {{method}} {{route}} {{status}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Save-item error rate (backend POST /api/items, 5xx share)",
      "description": "Same expression as the SaveItemFailing alert (#15): > 5% over 5 minutes.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "custom": {
            "axisSoftMax": 0.1
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(sum(rate(http_requests_total{job=\"para-luego-backend\", route=\"/api/items\", method=\"POST\", status=~\"5..\"}[5m])) or vector(0)) / clamp_min(sum(rate(http_requests_total{job=\"para-luego-backend\", route=\"/api/items\", method=\"POST\"}[5m])), 1e-9)",
          "legendFormat": "save-item 5xx share"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "5xx share by service (any route)",
      "description": "Same expression as the HighServerErrors alert (#15): > 5% over 5 minutes.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 14,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "custom": {
            "axisSoftMax": 0.1
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(sum by (job) (rate(http_requests_total{status=~\"5..\"}[5m])) or (sum by (job) (rate(http_requests_total[5m])) * 0)) / clamp_min(sum by (job) (rate(http_requests_total[5m])), 1e-9)",
          "legendFormat": "{{job}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "p95 latency by route",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 22,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le, job, route) (rate(http_server_request_duration_seconds_bucket[5m])))",
          "legendFormat": "{{job}} {{route}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Items saved per minute",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 22,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(items_saved_total[5m])) * 60",
          "legendFormat": "items saved / min"
        }
      ]
    },
    {
      "id": 6,
      "type": "logs",
      "title": "App logs (JSON, click trace_id to open the trace)",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 30,
        "w": 24,
        "h": 10
      },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{service_name=~\"para-luego-.+\"}"
        }
      ]
    }
  ],
  "description": "Save-item journey (#13/#14): request rates, errors, latency, items saved and logs."
}
