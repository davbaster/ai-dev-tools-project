# Copy to .env and adjust. Never commit .env.

# Where the app runs: local, dev or prod. Defaults to local when unset.
DEPLOYMENT=local

# Local Postgres in Docker Compose (local-only dummy values).
POSTGRES_USER=para_luego
POSTGRES_PASSWORD=change_me_local_only
POSTGRES_DB=para_luego

# Host ports used by `make up` (defaults 8000, 8001 and 5432).
FRONTEND_PORT=8000
BACKEND_PORT=8001
DB_PORT=5432

# Backend database for `make dev-backend` and `make migrate` (Compose sets its own).
DATABASE_URL=postgresql://para_luego:change_me_local_only@localhost:5432/para_luego

# Database the integration tests may wipe. Never point it at the dev database.
# Default: para_luego_test on the Compose Postgres with the Compose default password.
TEST_DATABASE_URL=postgresql://para_luego:change_me_local_only@localhost:5432/para_luego_test

# Where the frontend finds the backend API when run with `make dev-frontend`.
# Docker Compose sets it to http://backend:8001 by itself.
BACKEND_URL=http://localhost:8001
