# Copy to .env and adjust. Never commit .env.

# Where the app runs: local, dev or prod. Defaults to local when unset.
DEPLOYMENT=local

# Local Postgres in Docker Compose (local-only dummy values).
POSTGRES_USER=para_luego
POSTGRES_PASSWORD=change_me_local_only
POSTGRES_DB=para_luego

# Host ports used by `make up` (defaults 8000 and 5432).
APP_PORT=8000
DB_PORT=5432
