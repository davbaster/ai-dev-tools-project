# Copy to .env and adjust. Never commit .env.

# Where the app runs: local, dev or prod. Defaults to local when unset.
DEPLOYMENT=local

# Local Postgres in Docker Compose (local-only dummy values).
POSTGRES_USER=para_luego
POSTGRES_PASSWORD=change_me_local_only
POSTGRES_DB=para_luego

# Host ports used by `make up` (defaults 8000, 8001 and 5432).
FRONTEND_PORT=8000
BACKEND_PORT=8001
DB_PORT=5432

# Where the frontend finds the backend API when run with `make dev-frontend`.
# Docker Compose sets it to http://backend:8001 by itself.
BACKEND_URL=http://localhost:8001
