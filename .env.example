# Copy to .env and adjust. Never commit .env.

# Where the app runs: local, dev or prod. Defaults to local when unset.
DEPLOYMENT=local

# Local Postgres in Docker Compose (local-only dummy values).
POSTGRES_USER=para_luego
POSTGRES_PASSWORD=change_me_local_only
POSTGRES_DB=para_luego

# Host ports used by `make up` (defaults 8000, 8001 and 5432).
FRONTEND_PORT=8000
BACKEND_PORT=8001
DB_PORT=5432

# Local observability stack (#14), bound to 127.0.0.1 only.
GRAFANA_PORT=3000
PROMETHEUS_PORT=9090
TEMPO_PORT=3200
LOKI_PORT=3100
# Grafana opens without login locally; this is the admin password (local only).
GRAFANA_ADMIN_PASSWORD=change_me_local_only

# Backend database for `make dev-backend` and `make migrate` (Compose sets its own).
DATABASE_URL=postgresql://para_luego:change_me_local_only@localhost:5432/para_luego

# Integration tests: `make test-integration` starts its own throwaway Postgres on
# port 5433 (TEST_DB_PORT) and needs nothing here. Set TEST_DATABASE_URL only to
# use another database the tests may wipe (never the dev `para_luego` one), e.g.:
# TEST_DATABASE_URL=postgresql://para_luego:para_luego_local@localhost:5433/para_luego_test

# Where the frontend finds the backend API when run with `make dev-frontend`.
# Docker Compose sets it to http://backend:8001 by itself.
BACKEND_URL=http://localhost:8001

# Seconds the frontend waits for the backend (default 2). Render sets 60 because
# a sleeping free backend takes about a minute to wake up.
BACKEND_TIMEOUT_SECONDS=2

# Seconds the frontend keeps retrying a failing backend call (GETs, or any call
# whose connection failed). 0 = no retries (local). Render sets 5.
BACKEND_WAKE_SECONDS=0

# Backend URL the user's browser can reach. When set, the "service unavailable"
# page and the login page call its /api/health from the browser (that wakes a
# sleeping Render backend) and reload. Unset locally.
# BACKEND_PUBLIC_URL=https://para-luego-dev-backend.onrender.com

# Telemetry (#13). Traces and metrics go over OTLP/HTTP only when this is set
# (the local collector from #14); unset, nothing leaves the process. Logs are
# always JSON on stdout.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
LOG_LEVEL=INFO

# Version reported by the health checks. CD bakes the commit SHA into the image;
# unset means "local".
APP_VERSION=local
